<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PacePlanner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PacePlanner.App"
    xmlns:data="using:PacePlanner.Data"
    xmlns:export="using:PacePlanner.Core.Export"
    Title="賽道配速規劃師 PacePlanner">

    <Grid x:Name="Root" Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Plans -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="方案" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Plans}"
                      SelectedItem="{x:Bind ViewModel.SelectedPlan, Mode=TwoWay}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:PlanSummary">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Margin="0,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="2" ColumnSpacing="6" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Button Content="新增" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.NewPlanCommand}" />
                <Button Grid.Column="1" Content="複製" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.DuplicatePlanCommand}" />
                <Button Grid.Row="1" Content="重新命名" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RenamePlanCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Content="刪除" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.DeletePlanCommand}" />
            </Grid>
        </Grid>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="{x:Bind ViewModel.PlanName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                <TextBlock Text="賽道" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Content="匯入 GPX…" Command="{x:Bind ViewModel.ImportGpxCommand}" />
                <TextBlock Text="{x:Bind ViewModel.GpxFileName, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                <Grid ColumnSpacing="8" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="總距離" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CourseDistanceText, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="累計爬升" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AscentText, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="累計下降" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DescentText, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="最高海拔" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.MaxElevationText, Mode=OneWay}" />
                    <TextBlock Grid.Row="4" Text="最低海拔" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.MinElevationText, Mode=OneWay}" />
                </Grid>
                <InfoBar IsOpen="{x:Bind ViewModel.HasCourseNote, Mode=OneWay}" IsClosable="False" Severity="Warning"
                         Message="{x:Bind ViewModel.CourseNote, Mode=OneWay}" />

                <TextBlock Text="賽事與目標" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox Header="距離" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.DistanceOptions}"
                          SelectedIndex="{x:Bind ViewModel.DistanceIndex, Mode=TwoWay}" />
                <NumberBox Header="自訂距離 (km)" Minimum="0.1" Maximum="1000" SmallChange="0.1" SpinButtonPlacementMode="Compact"
                           Visibility="{x:Bind ViewModel.IsCustomDistance, Mode=OneWay}"
                           Value="{x:Bind ViewModel.CustomDistanceKm, Mode=TwoWay}" />
                <TextBox Header="目標完賽時間 (hh:mm:ss)" PlaceholderText="3:45:00"
                         Text="{x:Bind ViewModel.TargetTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="配速策略" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.StrategyOptions}"
                          SelectedIndex="{x:Bind ViewModel.StrategyIndex, Mode=TwoWay}" />
                <NumberBox Header="後半程每公里快幾秒" Minimum="0" Maximum="120" SpinButtonPlacementMode="Compact"
                           Visibility="{x:Bind ViewModel.IsNegativeSplit, Mode=OneWay}"
                           Value="{x:Bind ViewModel.NegativeSplitSeconds, Mode=TwoWay}" />

                <TextBlock Text="補給站" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AidModeOptions}"
                          SelectedIndex="{x:Bind ViewModel.AidModeIndex, Mode=TwoWay}" />
                <NumberBox Header="每隔幾公里" Minimum="0.5" Maximum="100" SmallChange="0.5" SpinButtonPlacementMode="Compact"
                           Visibility="{x:Bind ViewModel.IsAidEveryN, Mode=OneWay}"
                           Value="{x:Bind ViewModel.AidIntervalKm, Mode=TwoWay}" />
                <TextBox Header="補給站公里數（以逗號分隔）" PlaceholderText="5, 10.5, 21"
                         Visibility="{x:Bind ViewModel.IsAidList, Mode=OneWay}"
                         Text="{x:Bind ViewModel.AidListText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <NumberBox Header="每站停留秒數" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Compact"
                           Visibility="{x:Bind ViewModel.HasAid, Mode=OneWay}"
                           Value="{x:Bind ViewModel.AidStopSeconds, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="儲存" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                    <Button Content="匯出 CSV" Command="{x:Bind ViewModel.ExportCsvCommand}" />
                    <Button Content="匯出列印版" Command="{x:Bind ViewModel.ExportHtmlCommand}" />
                </StackPanel>
                <TextBlock Text="切換方案或關閉程式時會自動儲存。" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Results -->
        <Grid Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="錯誤"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Severity="Success"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Border Grid.Row="2" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Canvas x:Name="ProfileCanvas" SizeChanged="ProfileCanvas_SizeChanged" />
            </Border>

            <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <Grid Grid.Row="4" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" /><ColumnDefinition Width="130" /><ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="段" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="起訖 (km)" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="段距離" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="坡度 %" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="目標配速" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="跑步用時" FontWeight="SemiBold" />
                <TextBlock Grid.Column="6" Text="補給(秒)" FontWeight="SemiBold" />
                <TextBlock Grid.Column="7" Text="該段用時" FontWeight="SemiBold" />
                <TextBlock Grid.Column="8" Text="累計時間" FontWeight="SemiBold" />
            </Grid>

            <ListView Grid.Row="5" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="26" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="export:SplitRow">
                        <Grid ColumnSpacing="4" Background="{x:Bind local:MainWindow.RowBackground(HasAidStation)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" /><ColumnDefinition Width="130" /><ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Index}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind local:MainWindow.Range(StartKm, EndKm)}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DistanceKm}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Grade}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Pace}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="{x:Bind RunTime}" />
                            <TextBlock Grid.Column="6" Text="{x:Bind AidStop}" />
                            <TextBlock Grid.Column="7" Text="{x:Bind Duration}" />
                            <TextBlock Grid.Column="8" Text="{x:Bind Cumulative}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
